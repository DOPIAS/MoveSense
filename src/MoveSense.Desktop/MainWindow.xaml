<Window x:Class="MoveSense.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="MoveSense" Width="1100" Height="850" MinWidth="850" MinHeight="650" WindowStartupLocation="CenterScreen" Icon="MoveSense.ico" AllowDrop="True" PreviewDragOver="FileDragOver" PreviewDrop="FileDropped">
<Grid Background="{DynamicResource Background}">
<Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#18262D"><DockPanel Margin="16,28,16,22">
<StackPanel DockPanel.Dock="Top" Margin="12,0,0,30"><TextBlock Text="MoveSense" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="0.2.1 · PREVIEW" Foreground="#93A6AE" FontSize="10" Margin="0,7,0,0"/></StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Button Content="{DynamicResource DesktopSetup}" Style="{StaticResource Nav}" Click="ShowSettings"/><TextBlock Text="{DynamicResource ScopeNote}" Foreground="#93A6AE" TextWrapping="Wrap" FontSize="12" Margin="12,12,6,0"/></StackPanel>
<StackPanel><Button x:Name="MoveNav" Content="{DynamicResource MoveNav}" Style="{StaticResource Nav}" Click="ShowMove" Background="#2B4249"/><Button x:Name="HistoryNav" Content="{DynamicResource HistoryNav}" Style="{StaticResource Nav}" Click="ShowHistory"/><Button x:Name="SettingsNav" Content="{DynamicResource SettingsNav}" Style="{StaticResource Nav}" Click="ShowSettings"/></StackPanel>
</DockPanel></Border>
<Grid Grid.Column="1" Margin="28,24,28,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="MovePage"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
<TextBlock Text="{DynamicResource Heading}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Subtitle}" Foreground="{DynamicResource Muted}" Margin="0,8,0,22" TextWrapping="Wrap"/>
<Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="16,12" Margin="0,0,0,16"><DockPanel>
<Button x:Name="EnableMenuButton" DockPanel.Dock="Right" Content="{DynamicResource EnableMenu}" Click="RegisterExplorer" VerticalAlignment="Center" Margin="14,0,0,0"/>
<StackPanel><TextBlock Text="{DynamicResource RightClickHeading}" FontWeight="SemiBold"/><TextBlock x:Name="MenuStatusText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
</DockPanel></Border><StackPanel x:Name="InputPanel">
<Border x:Name="DropZone" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="22,18"><StackPanel>
<TextBlock Text="{DynamicResource SourceStep}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" FontSize="12"/>
<TextBlock x:Name="SourceTitle" Text="{DynamicResource DropTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,4" TextTrimming="CharacterEllipsis"/>
<TextBox x:Name="SourceBox" IsReadOnly="True" TextChanged="InputsChanged" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="24" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.Name="Selected file or folder"/>
<StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="{DynamicResource File}" Click="BrowseFile" Margin="0,0,8,0"/><Button Content="{DynamicResource Folder}" Click="BrowseSource"/></StackPanel>
</StackPanel></Border>
<Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="22,18" Margin="0,12,0,0"><StackPanel>
<TextBlock Text="{DynamicResource DestinationStep}" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" FontSize="12"/>
<DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="{DynamicResource ChooseFolder}" Click="BrowseDestination" Margin="12,0,0,0"/><TextBox x:Name="DestinationBox" IsReadOnly="True" TextChanged="InputsChanged" AutomationProperties.Name="Destination folder"/></DockPanel>
<StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="{DynamicResource Desktop}" Click="ChooseDesktop" Margin="0,0,8,0"/><Button Content="{DynamicResource Documents}" Click="ChooseDocuments"/></StackPanel>
<TextBlock x:Name="DestinationPreview" Text="{DynamicResource DestinationHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
</StackPanel></Border>
<CheckBox x:Name="NearbyBox" IsChecked="True" Checked="OptionsChanged" Unchecked="OptionsChanged" Margin="2,14,0,3"><TextBlock Text="{DynamicResource Nearby}" TextWrapping="Wrap"/></CheckBox>
<TextBlock x:Name="ScopeDescription" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="21,0,0,10"/>
<Expander Header="{DynamicResource MoreOptions}" Foreground="{DynamicResource Text}" Margin="0,2,0,12"><StackPanel Margin="20,12,0,0">
<TextBlock Text="{DynamicResource Rename}"/><TextBox x:Name="NameBox" TextChanged="InputsChanged" Margin="0,5,0,12" AutomationProperties.Name="Name after moving"/>
<TextBlock Text="{DynamicResource ScanScope}"/><DockPanel Margin="0,5,0,10"><Button DockPanel.Dock="Right" Content="{DynamicResource Browse}" Click="BrowseScope" Margin="8,0,0,0"/><TextBox x:Name="ScopeBox" TextChanged="InputsChanged" AutomationProperties.Name="Additional folder to scan"/></DockPanel>
<CheckBox x:Name="RepairBox" IsChecked="True"><TextBlock Text="{DynamicResource Repair}" TextWrapping="Wrap"/></CheckBox>
</StackPanel></Expander></StackPanel>
<Border x:Name="ReviewPanel" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="20,16" Margin="0,6,0,14"><StackPanel><TextBlock x:Name="ReviewTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="CoverageText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
<Expander x:Name="DetailsPanel" Header="{DynamicResource Details}" Foreground="{DynamicResource Text}" Visibility="Collapsed" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><TabControl x:Name="ResultsTabs">
<TabItem Header="{DynamicResource References}"><Grid Height="220"><DataGrid x:Name="ReferencesGrid" SelectionChanged="ReferenceSelected" AutomationProperties.Name="Analyzed file references"><DataGrid.Columns><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Referenced from" Binding="{Binding Owner}" Width="*"/><DataGridTextColumn Header="Current path" Binding="{Binding Current}" Width="1.2*"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyState" Text="{DynamicResource NoReferences}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="450"/></Grid></TabItem>
<TabItem Header="{DynamicResource ScanNotes}"><TextBox x:Name="WarningsBox" Height="220" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
<Border x:Name="PreviewPanel" Background="{DynamicResource AccentSoft}" Padding="14" Margin="0,10,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="PreviewOwner" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBox x:Name="BeforeBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="12"/><TextBox x:Name="AfterBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontSize="12"/><TextBlock x:Name="PreviewNote" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12"/></StackPanel></Border>
</StackPanel></Expander>
<CheckBox x:Name="AcknowledgeBox" Visibility="Collapsed" Checked="AcknowledgmentChanged" Unchecked="AcknowledgmentChanged"><TextBlock Text="{DynamicResource Acknowledge}" TextWrapping="Wrap"/></CheckBox>
<Border x:Name="CompletionPanel" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="22" Margin="0,8,0,0"><StackPanel><TextBlock x:Name="CompletionTitle" TextWrapping="Wrap" Text="{DynamicResource Completed}" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="CompletedPath" TextWrapping="Wrap" Margin="0,10,0,18"/><WrapPanel><Button Content="{DynamicResource OpenFolder}" Click="OpenCompletedFolder" Margin="0,0,8,8"/><Button x:Name="QuickUndoButton" Content="{DynamicResource QuickUndo}" Click="QuickUndoClick" Margin="0,0,8,8"/><Button Content="{DynamicResource NewMove}" Click="NewMoveClick" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer>
<Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ActionHint" Text="{DynamicResource EmptySummary}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/><Button Grid.Column="1" x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="CancelScan" Visibility="Collapsed" Margin="0,0,8,0"/><Button Grid.Column="2" x:Name="AnalyzeButton" Content="{DynamicResource Analyze}" Style="{StaticResource Primary}" Click="AnalyzeClick" IsEnabled="False" MinWidth="150"/><Button Grid.Column="2" x:Name="MoveButton" Content="{DynamicResource MoveAction}" Style="{StaticResource Primary}" Click="MoveClick" Visibility="Collapsed" IsEnabled="False" MinWidth="150"/></Grid>
</Grid>
<Grid x:Name="HistoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{DynamicResource HistoryNav}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource HistoryHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,24"/></StackPanel><Button Grid.Row="1" Content="{DynamicResource Refresh}" Click="RefreshHistoryClick" HorizontalAlignment="Right" Margin="0,0,0,12"/><DataGrid Grid.Row="2" x:Name="HistoryGrid" AutomationProperties.Name="Move operation history"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="140"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/></DataGrid.Columns></DataGrid><Button Grid.Row="3" Content="{DynamicResource Undo}" Style="{StaticResource Primary}" Click="UndoClick" HorizontalAlignment="Right" Margin="0,16,0,0"/></Grid>
<ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,20,0">
<TextBlock Text="{DynamicResource SettingsNav}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
<TextBlock Text="{DynamicResource RightClickHeading}" FontSize="20" FontWeight="SemiBold"/>
<TextBlock Text="{DynamicResource ExplorerHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
<WrapPanel><Button x:Name="SettingsEnableMenuButton" Content="{DynamicResource EnableMenu}" Click="RegisterExplorer" Margin="0,0,8,8"/><Button x:Name="RemoveMenuButton" Content="{DynamicResource ExplorerRemove}" Click="RemoveExplorer" Margin="0,0,0,8"/></WrapPanel>
<TextBlock x:Name="SetupStatus" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,4,0,14"/>
<Expander Header="{DynamicResource DesktopSetup}" Foreground="{DynamicResource Text}" Margin="0,4,0,14"><StackPanel><TextBlock Text="{DynamicResource DesktopHelp}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/><Button Content="{DynamicResource CreateShortcut}" Click="CreateDesktopShortcut" HorizontalAlignment="Left"/></StackPanel></Expander><TextBlock Text="{DynamicResource Appearance}" FontWeight="SemiBold" Margin="0,12,0,8"/><ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" Padding="8" SelectionChanged="ThemeChanged"><ComboBoxItem Content="{DynamicResource SystemTheme}"/><ComboBoxItem Content="{DynamicResource LightTheme}"/><ComboBoxItem Content="{DynamicResource DarkTheme}"/></ComboBox>
<TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" Margin="0,20,0,8"/><ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left" Padding="8" SelectionChanged="LanguageChanged"><ComboBoxItem Content="English"/><ComboBoxItem Content="Русский"/></ComboBox>
<Expander Header="{DynamicResource LimitsHeading}" Foreground="{DynamicResource Text}" Margin="0,24,0,0"><TextBlock Text="{DynamicResource LimitsText}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0"/></Expander><TextBlock Text="MoveSense 0.2.1 · MIT" Foreground="{DynamicResource Muted}" Margin="0,24,0,0"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><StackPanel><ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/><TextBlock x:Name="StatusText" Text="{DynamicResource Ready}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
</Grid></Grid></Window>
